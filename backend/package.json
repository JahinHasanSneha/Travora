{
  "name": "tripclone-backend",
  "version": "1.0.0",
  "description": "TripAdvisor Clone - Backend API (100% open-source stack)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/db/migrate.js",
    "migrate:incremental": "node src/db/migrate.js --only-migrations",
   "seed": "node src/seeds/index.js",
"seed:users": "node src/seeds/seed-users.js",
"seed:companies": "node src/seeds/seed-companies.js",
"seed:suppliers": "node src/seeds/seed-suppliers.js",
"seed:places": "node src/seeds/seed-places.js",
"seed:hotels": "node src/seeds/seed-hotels.js",
"seed:restaurants": "node src/seeds/seed-restaurants.js",
"seed:cruises": "node src/seeds/seed-cruises.js",
"seed:packages": "node src/seeds/seed-packages.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.11.5",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.4.5",
    "cors": "^2.8.5",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
